{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "decision-router": {
      "type": "stdio",
      "command": "python3",
      "args": ["${PLUGIN_ROOT}/server/main.py", "serve"],
